# Copy to .env and adjust. Values below are the built-in defaults.

# Flask
SECRET_KEY=dev-secret-change-me
FLASK_DEBUG=1
HOST=0.0.0.0
PORT=5000

# Comma separated list of allowed origins, or * for any
CORS_ORIGINS=*

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=musiky
# Use an in-memory database (no mongod required) for local demos and tests
MONGO_MOCK=0
MONGO_TIMEOUT_MS=2000

# YouTube Data API v3 - https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=10

# Rooms
ROOM_CODE_LENGTH=6
ROOM_TTL_SECONDS=21600
ROOM_MAX_PARTICIPANTS=50
ROOM_MAX_QUEUE=100
CHAT_MAX_LENGTH=500
